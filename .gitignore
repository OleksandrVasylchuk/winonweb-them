# Dependencies — dev only, never needed to run the theme
/node_modules/
/vendor/

# Quality-gate output: rendered pages, downloaded tooling
/artifacts/

# Source designs handed over for conversion — never part of the theme
/designs/

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log

# Environment
.env
.env.*

# Reference design handed over for pixel-matching — not part of the theme
/design-reference/

# Blocks the importer generated from a client's design, and the canonical
# stylesheets they share. They belong to the site they were built for, not to
# the theme: build-zip.mjs and phpcs.xml.dist already treat them that way, and
# a client's markup committed here ships to the next client. Committed once by
# accident in 65fae82 and untracked again.
/blocks/design/
