#: assets/js/admin-import.js:102
msgid "Choose a ZIP file first."
msgstr "Спершу виберіть ZIP-файл."

#: assets/js/admin-import.js:110
msgid "Unpacking and reading the design…"
msgstr "Розпаковую та читаю дизайн…"

#. translators: 1: number of files, 2: number of pages.
#: assets/js/admin-import.js:118
msgid "Read %1$d files and found %2$d pages."
msgstr "Прочитано %1$d файлів, знайдено %2$d сторінок."

#: assets/js/admin-import.js:132
msgid "Design archive (.zip)"
msgstr "Архів дизайну (.zip)"

#: assets/js/admin-import.js:138
msgid "1. Upload the design"
msgstr "1. Завантажте дизайн"

#. translators: 1: file path, 2: number of sections.
#: assets/js/admin-import.js:171
msgid "%1$s — %2$d sections"
msgstr "%1$s — секцій: %2$d"

#: assets/js/admin-import.js:181
msgid "2. Pick a page"
msgstr "2. Виберіть сторінку"

#. translators: %s: comma-separated language codes.
#: assets/js/admin-import.js:189
msgid "This design has %s. Import one language first; the others can be added later with a translation plugin."
msgstr "Цей дизайн має %s. Спершу імпортуйте одну мову; решту можна додати пізніше плагіном перекладу."

#. translators: %d: number of files.
#: assets/js/admin-import.js:201
msgid "%d files were not unpacked"
msgstr "Не розпаковано файлів: %d"

#: assets/js/admin-import.js:222
msgid "Reading the page…"
msgstr "Читаю сторінку…"

#. translators: %d: number of sections.
#: assets/js/admin-import.js:239
msgid "Found %d sections on this page."
msgstr "На цій сторінці знайдено секцій: %d"

#: assets/js/admin-import.js:274
msgid "Build the whole site"
msgstr "Побудувати весь сайт"

#: assets/js/admin-import.js:281
msgid "Build everything at once"
msgstr "Зібрати все одразу"

#: assets/js/admin-import.js:284
msgid "Creates every page, imports the images, builds the menu and the header and footer, and sets the front page. No API key and no conversation needed. You can undo it and run it again."
msgstr "Створює всі сторінки, переносить зображення, збирає меню, хедер і футер, призначає головну. Без ключа API й без чату. Можна скасувати й повторити."

#: assets/js/admin-import.js:291
msgid "Language to build:"
msgstr "Мова для збірки:"

#: assets/js/admin-import.js:300
msgid "Changed your mind, or got a new version of the design? Delete everything and drop the new archive in — nothing here is one-way."
msgstr "Передумали або маєте нову версію дизайну? Видаліть усе й закиньте новий архів — тут ніщо не робиться в один бік."

#: assets/js/admin-import.js:310
msgid "Delete everything and start over"
msgstr "Видалити все й почати заново"

#: assets/js/admin-import.js:311
msgid "Removes only what an import created. Your own pages are left alone."
msgstr "Видаляє лише те, що створив імпорт. Ваші власні сторінки не чіпає."

#: assets/js/admin-import.js:336
msgid "Structure only — the button above"
msgstr "Тільки структура — кнопка вище"

#: assets/js/admin-import.js:337
msgid "Free, instant, no account. Headings, lists, cards and images become blocks."
msgstr "Безкоштовно, миттєво, без реєстрації. Заголовки, списки, картки й зображення стають блоками."

#: assets/js/admin-import.js:340
msgid "Your Claude subscription"
msgstr "Ваша підписка Claude"

#: assets/js/admin-import.js:341
msgid "Free with any plan. Pick a page below, copy the brief into your Claude chat, paste the reply back. Better judgement than the button."
msgstr "Безкоштовно з будь-яким тарифом. Виберіть сторінку нижче, скопіюйте завдання у свій чат Клода і вставте відповідь назад. Якісніше, ніж кнопка."

#: assets/js/admin-import.js:344
msgid "An Anthropic API key"
msgstr "Ключ API Anthropic"

#: assets/js/admin-import.js:345
msgid "One click per page, no copying. Roughly one to three dollars for a whole site. Set the key in Connection settings above."
msgstr "Один клік на сторінку, без копіювання. Приблизно один–три долари за весь сайт. Ключ вказується в «Налаштуваннях підключення» вище."

#: assets/js/admin-import.js:357
msgid "Three ways to convert — which should I use?"
msgstr "Три способи конвертації — який обрати?"

#: assets/js/admin-import.js:373
msgid "(%d sections)"
msgstr "(секцій: %d)"

#: assets/js/admin-import.js:381
msgid "The site is built."
msgstr "Сайт зібрано."

#: assets/js/admin-import.js:384 assets/js/admin-import.js:782
msgid "Worth checking:"
msgstr "Варто перевірити:"

#: assets/js/admin-import.js:393
msgid "Building the site — this takes a moment…"
msgstr "Збираю сайт — це трохи забере часу…"

#. translators: 1: pages built, 2: images imported.
#: assets/js/admin-import.js:406
msgid "Built %1$d pages and imported %2$d images. Look through them, then edit anything you like."
msgstr "Зібрано %1$d сторінок, перенесено %2$d зображень. Перегляньте їх і редагуйте що завгодно."

#: assets/js/admin-import.js:422
msgid "Undoing…"
msgstr "Скасовую…"

#. translators: 1: pages removed, 2: images removed.
#: assets/js/admin-import.js:431
msgid "Removed %1$d pages and %2$d images. The site is back to how it was."
msgstr "Видалено %1$d сторінок і %2$d зображень. Сайт повернуто у попередній стан."

#: assets/js/admin-import.js:459
msgid "3. Convert each section"
msgstr "3. Конвертуйте кожну секцію"

#: assets/js/admin-import.js:462
msgid "Convert a section, read what it says, then keep it. Nothing reaches your site until you press Keep."
msgstr "Сконвертуйте секцію, прочитайте опис і залиште її. Нічого не потрапляє на сайт, доки ви не натиснете «Залишити»."

#: assets/js/admin-import.js:468
msgid "Convert every section"
msgstr "Конвертувати всі секції"

#: assets/js/admin-import.js:474
msgid "Keep the whole page as a draft"
msgstr "Залишити цілу сторінку як чернетку"

#: assets/js/admin-import.js:480
msgid "Draft page created."
msgstr "Чернетку сторінки створено."

#: assets/js/admin-import.js:483 assets/js/admin-import.js:806
msgid "Open it in the editor"
msgstr "Відкрити в редакторі"

#: assets/js/admin-import.js:504
msgid "Paste the whole reply here, including the opening [ and closing ]"
msgstr "Вставте сюди всю відповідь, разом із відкривною [ і закривною ]"

#: assets/js/admin-import.js:526
msgid "The brief — select it all and copy"
msgstr "Завдання — виділіть усе й скопіюйте"

#: assets/js/admin-import.js:533
msgid "Copy the brief"
msgstr "Скопіювати завдання"

#: assets/js/admin-import.js:540
msgid "No API key? Use your own Claude subscription instead"
msgstr "Немає ключа API? Скористайтеся власною підпискою Claude"

#: assets/js/admin-import.js:542
msgid "Copy the brief for this page."
msgstr "Скопіюйте завдання для цієї сторінки."

#: assets/js/admin-import.js:543
msgid "Paste it into your Claude conversation and send it."
msgstr "Вставте його у свій чат із Клодом і надішліть."

#: assets/js/admin-import.js:544
msgid "Copy the whole reply and paste it below."
msgstr "Скопіюйте всю відповідь і вставте нижче."

#: assets/js/admin-import.js:552
msgid "Claude’s reply"
msgstr "Відповідь Клода"

#: assets/js/admin-import.js:559
msgid "Read the reply"
msgstr "Прочитати відповідь"

#: assets/js/admin-import.js:572
msgid "Building the brief…"
msgstr "Готую завдання…"

#. translators: 1: number of sections, 2: size in kilobytes.
#: assets/js/admin-import.js:586
msgid "Brief for %1$d sections, %2$d KB."
msgstr "Завдання на %1$d секцій, %2$d КБ."

#: assets/js/admin-import.js:593
msgid "Copied — now paste it into Claude"
msgstr "Скопійовано — тепер вставте в Клода"

#: assets/js/admin-import.js:594
msgid "Copied. Paste it into Claude, then bring the reply back."
msgstr "Скопійовано. Вставте в Клода й поверніть відповідь сюди."

#: assets/js/admin-import.js:609
msgid "The browser would not copy it, so it is in the box below — select it all and copy it yourself."
msgstr "Браузер не дав скопіювати, тож завдання в полі нижче — виділіть усе й скопіюйте вручну."

#: assets/js/admin-import.js:650
msgid "The browser refused to copy."
msgstr "Браузер відмовився копіювати."

#: assets/js/admin-import.js:657
msgid "Paste the reply first."
msgstr "Спершу вставте відповідь."

#: assets/js/admin-import.js:661
msgid "Reading the reply…"
msgstr "Читаю відповідь…"

#. translators: 1: sections received, 2: sections expected.
#: assets/js/admin-import.js:679
msgid "Read %1$d sections, but this page has %2$d. Check the reply was not cut off."
msgstr "Прочитано %1$d секцій, а на сторінці їх %2$d. Перевірте, чи відповідь не обірвалася."

#. translators: 1: sections received, 2: sections expected. */ __( 'Read %1$d sections, but this page has %2$d. Check the reply was not cut off.', 'wow-signal' ), data.received, data.expected ), true ); return; } say( sprintf( /* translators: %d: number of sections.
#: assets/js/admin-import.js:691
msgid "Read %d sections. Review each one before keeping it."
msgstr "Прочитано %d секцій. Перегляньте кожну, перш ніж залишати."

#. translators: 1: element name, 2: word count, 3: image count.
#: assets/js/admin-import.js:710
msgid "<%1$s> · %2$d words · %3$d images"
msgstr "<%1$s> · слів: %2$d · зображень: %3$d"

#: assets/js/admin-import.js:725
msgid "Convert this section"
msgstr "Конвертувати цю секцію"

#: assets/js/admin-import.js:732
msgid "Converting…"
msgstr "Конвертую…"

#: assets/js/admin-import.js:739 assets/js/admin-import.js:766
msgid "Try again"
msgstr "Спробувати ще раз"

#: assets/js/admin-import.js:74
msgid "Something went wrong."
msgstr "Щось пішло не так."

#: assets/js/admin-import.js:760
msgid "This conversion was refused:"
msgstr "Цю конвертацію відхилено:"

#: assets/js/admin-import.js:777
msgid "You will be able to edit:"
msgstr "Ви зможете редагувати:"

#: assets/js/admin-import.js:787
msgid "Quality notes:"
msgstr "Зауваження щодо якості:"

#: assets/js/admin-import.js:797
msgid "Preview"
msgstr "Перегляд"

#: assets/js/admin-import.js:805
msgid "Kept."
msgstr "Залишено."

#: assets/js/admin-import.js:818
msgid "Keep as a reusable section"
msgstr "Залишити як багаторазову секцію"

#: assets/js/admin-import.js:826
msgid "Keep as a draft page"
msgstr "Залишити як чернетку сторінки"

#: assets/js/admin-import.js:851
msgid "Add your Anthropic API key in the connection settings first."
msgstr "Спершу додайте ключ API Anthropic у налаштуваннях підключення."

#. translators: %s: section name.
#: assets/js/admin-import.js:857
msgid "Converting “%s”…"
msgstr "Конвертую «%s»…"

#. translators: %s: section name.
#: assets/js/admin-import.js:873
msgid "“%s” converted. Review it below."
msgstr "«%s» сконвертовано. Перегляньте результат нижче."

#. translators: %s: section name. */ __( '“%s” converted. Review it below.', 'wow-signal' ), section.label ) : sprintf( /* translators: %s: section name.
#: assets/js/admin-import.js:874
msgid "“%s” was refused — see the reason below."
msgstr "«%s» відхилено — причина нижче."

#: assets/js/admin-import.js:899
msgid "All sections converted. Review each one before keeping it."
msgstr "Усі секції сконвертовано. Перегляньте кожну, перш ніж залишати."

#: assets/js/admin-import.js:927
msgid "Convert at least one section first."
msgstr "Спершу сконвертуйте хоча б одну секцію."

#: assets/js/admin-import.js:93
msgid "Upload and read the design"
msgstr "Завантажити й прочитати дизайн"

#: assets/js/admin-import.js:933
msgid "Building the page…"
msgstr "Збираю сторінку…"

#. translators: 1: sections kept, 2: sections left out.
#: assets/js/admin-import.js:956
msgid "Draft page created from %1$d sections. %2$d were left out because they are not converted or were refused."
msgstr "Чернетку створено з %1$d секцій. %2$d не увійшли: не сконвертовані або відхилені."

#. translators: 1: sections kept, 2: sections left out. */ __( 'Draft page created from %1$d sections. %2$d were left out because they are not converted or were refused.', 'wow-signal' ), ordered.length, skipped ), true ); return; } say( sprintf( /* translators: %d: number of sections.
#: assets/js/admin-import.js:968
msgid "Draft page created from all %d sections."
msgstr "Чернетку створено з усіх %d секцій."

#: assets/js/admin-import.js:989
msgid "Saved."
msgstr "Збережено."

#: blocks/colophon/block.json
msgctxt "block title"
msgid "Colophon"
msgstr "Підпис у футері"

#: blocks/colophon/block.json
msgctxt "block keyword"
msgid "copyright"
msgstr "копірайт"

#: blocks/colophon/block.json
msgctxt "block keyword"
msgid "credit"
msgstr "підпис"

#: blocks/colophon/block.json
msgctxt "block keyword"
msgid "footer"
msgstr "футер"

#: blocks/colophon/block.json
msgctxt "block description"
msgid "The copyright line for the footer. Keeps the year current on its own and can show the designer credit."
msgstr "Рядок копірайту для футера. Сам оновлює рік і за потреби показує підпис дизайнера."

#: blocks/colophon/block.json
msgctxt "block keyword"
msgid "year"
msgstr "рік"

#: blocks/colophon/edit.js:27
msgid "Site name"
msgstr "Назва сайту"

#: blocks/colophon/edit.js:42
msgid "Colophon"
msgstr "Колофон"

#: blocks/colophon/edit.js:44
msgid "Symbol before the year"
msgstr "Символ перед роком"

#: blocks/colophon/edit.js:45
msgid "Usually ©. Leave empty to show the year on its own."
msgstr "Зазвичай ©. Залиште порожнім, щоб показувати лише рік."

#: blocks/colophon/edit.js:52
msgid "Show the site name"
msgstr "Показувати назву сайту"

#: blocks/colophon/edit.js:59
msgid "Extra text"
msgstr "Додатковий текст"

#: blocks/colophon/edit.js:60
msgid "Optional. Shown after the site name, for example \"All rights reserved\"."
msgstr "Необовʼязково. Показується після назви сайту, наприклад «Усі права захищено»."

#: blocks/colophon/render.php:52
msgid "WOW — Win On Web"
msgstr "WOW — Win On Web"

#: blocks/colophon/render.php:53
msgid "(opens in a new tab)"
msgstr "(відкриється в новій вкладці)"

#. translators: %s: linked studio name.
#: blocks/colophon/render.php:58
msgid "Design by %s"
msgstr "Дизайн — %s"

#: blocks/contact-form/block.json
msgctxt "block description"
msgid "An accessible contact form that emails the site owner. Protected by a nonce, a honeypot and a rate limit — no plugin needed."
msgstr "Доступна контактна форма, яка надсилає лист власнику сайту. Захищена nonce, пасткою для ботів і обмеженням частоти — без плагінів."

#: blocks/contact-form/block.json
msgctxt "block keyword"
msgid "contact"
msgstr "контакти"

#: blocks/contact-form/block.json
msgctxt "block title"
msgid "Contact form"
msgstr "Контактна форма"

#: blocks/contact-form/block.json
msgctxt "block keyword"
msgid "email"
msgstr "пошта"

#: blocks/contact-form/block.json
msgctxt "block keyword"
msgid "enquiry"
msgstr "запит"

#: blocks/contact-form/block.json
msgctxt "block keyword"
msgid "form"
msgstr "форма"

#: blocks/contact-form/block.json
msgctxt "block keyword"
msgid "lead"
msgstr "лід"

#: blocks/contact-form/edit.js:50
msgid "Form"
msgstr "Форма"

#: blocks/contact-form/edit.js:54
msgid "Messages go to the site administrator email set under Settings → General. A developer can route a form elsewhere with the wow_signal/contact_recipient filter."
msgstr "Повідомлення надходять на email адміністратора, вказаний у «Налаштування → Загальні». Розробник може перенаправити форму фільтром wow_signal/contact_recipient."

#: blocks/contact-form/edit.js:57
msgid "Form name"
msgstr "Назва форми"

#: blocks/contact-form/edit.js:58
msgid "Used to tell forms apart if the site has more than one, for example \"careers\"."
msgstr "Потрібна, щоб розрізняти форми, якщо їх на сайті кілька, наприклад «careers»."

#: blocks/contact-form/edit.js:65
msgid "Ask for a subject"
msgstr "Питати тему"

#: blocks/contact-form/edit.js:66
msgid "Adds an optional subject line above the message."
msgstr "Додає необовʼязкове поле теми над повідомленням."

#: blocks/contact-form/edit.js:73
msgid "Button text"
msgstr "Текст кнопки"

#: blocks/contact-form/edit.js:81
msgid "Thank-you message"
msgstr "Повідомлення подяки"

#: blocks/contact-form/edit.js:82
msgid "Shown on the page after the message is sent."
msgstr "Показується на сторінці після надсилання повідомлення."

#: blocks/contact-form/edit.js:89
msgid "Small print under the button"
msgstr "Дрібний текст під кнопкою"

#: blocks/contact-form/edit.js:90
msgid "Optional. Use it for a privacy note, for example how long you keep enquiries."
msgstr "Необовʼязково. Для примітки про приватність, наприклад скільки ви зберігаєте звернення."

#: blocks/contact-form/render.php:102
msgid "Your message was not sent."
msgstr "Повідомлення не надіслано."

#: blocks/contact-form/render.php:146
msgid "Leave this field empty"
msgstr "Залиште це поле порожнім"

#: blocks/contact-form/render.php:182 blocks/contact-form/render.php:230
msgid "(required)"
msgstr "(обов’язково)"

#: blocks/contact-form/render.php:195 blocks/contact-form/render.php:236
msgid "Error:"
msgstr "Помилка:"

#: blocks/contact-form/render.php:227 blocks/contact-form/edit.js:113
msgid "How can we help?"
msgstr "Чим можемо допомогти?"

#: blocks/contact-form/render.php:39 blocks/contact-form/edit.js:74 blocks/contact-form/edit.js:120
msgid "Send message"
msgstr "Надіслати повідомлення"

#: blocks/contact-form/render.php:40
msgid "Thank you — your message is on its way. We reply within one working day."
msgstr "Дякуємо — ваше повідомлення надіслано. Відповідаємо протягом одного робочого дня."

#: blocks/contact-form/render.php:65 blocks/contact-form/edit.js:104
msgid "Your name"
msgstr "Ваше ім’я"

#: blocks/contact-form/render.php:72 blocks/contact-form/edit.js:106
msgid "Email address"
msgstr "Електронна пошта"

#: blocks/contact-form/render.php:76 blocks/contact-form/edit.js:107
msgid "We reply to this address and never share it."
msgstr "Відповідаємо на цю адресу й нікому її не передаємо."

#: blocks/contact-form/render.php:79 blocks/contact-form/edit.js:111
msgid "Subject"
msgstr "Тема"

#: blocks/faq-item/block.json
msgctxt "block keyword"
msgid "answer"
msgstr "відповідь"

#: blocks/faq-item/block.json
msgctxt "block title"
msgid "FAQ question"
msgstr "Питання FAQ"

#: blocks/faq-item/block.json
msgctxt "block description"
msgid "One question and its answer. Add these inside an FAQ accordion."
msgstr "Одне питання та відповідь на нього. Додавайте всередину акордеона FAQ."

#: blocks/faq-item/block.json
msgctxt "block keyword"
msgid "question"
msgstr "питання"

#: blocks/faq-item/edit.js:19
msgid "Answer the question in a sentence or two…"
msgstr "Дайте відповідь одним-двома реченнями…"

#: blocks/faq-item/edit.js:42
msgid "Question"
msgstr "Питання"

#: blocks/faq-item/edit.js:44
msgid "Open when the page loads"
msgstr "Відкрито при завантаженні сторінки"

#: blocks/faq-item/edit.js:45
msgid "Use this for the one question most visitors ask."
msgstr "Використайте для того питання, яке ставлять найчастіше."

#: blocks/faq-item/edit.js:63
msgid "Type the question…"
msgstr "Введіть питання…"

#: blocks/faq/block.json
msgctxt "block description"
msgid "A list of questions that expand and collapse. Works without JavaScript and can publish itself to Google as an FAQ."
msgstr "Список питань, що розгортаються і згортаються. Працює без JavaScript і може передавати себе в Google як FAQ."

#: blocks/faq/block.json
msgctxt "block keyword"
msgid "accordion"
msgstr "акордеон"

#: blocks/faq/block.json
msgctxt "block keyword"
