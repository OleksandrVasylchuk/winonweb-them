{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "qs/metric",
	"title": "Metric",
	"category": "qs",
	"icon": "chart-bar",
	"description": "One number with a caption — a Lighthouse score, a conversion lift, a delivery time. Counts up when it scrolls into view.",
	"keywords": [ "metric", "number", "counter", "statistic", "kpi" ],
	"textdomain": "qwerty-soft-signal",
	"attributes": {
		"value": {
			"type": "string",
			"default": ""
		},
		"prefix": {
			"type": "string",
			"default": ""
		},
		"suffix": {
			"type": "string",
			"default": ""
		},
		"label": {
			"type": "string",
			"default": ""
		},
		"animate": {
			"type": "boolean",
			"default": true
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": false,
		"color": {
			"text": true,
			"background": true
		},
		"spacing": {
			"padding": true,
			"margin": [ "top", "bottom" ]
		},
		"typography": {
			"fontSize": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"editorScript": "file:./edit.js",
	"style": "file:./style.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
