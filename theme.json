{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "46rem",
			"wideSize": "78rem"
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"customGradient": true,
			"customDuotone": false,
			"link": true,
			"heading": true,
			"button": true,
			"caption": true,
			"palette": [
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Base — page background"
				},
				{
					"slug": "surface",
					"color": "#f4f4f4",
					"name": "Surface — card"
				},
				{
					"slug": "surface-2",
					"color": "#ebebeb",
					"name": "Surface raised"
				},
				{
					"slug": "border",
					"color": "#dedfe0",
					"name": "Divider (decorative)"
				},
				{
					"slug": "border-strong",
					"color": "#6f7480",
					"name": "Control border (AA)"
				},
				{
					"slug": "contrast",
					"color": "#212121",
					"name": "Contrast — body text"
				},
				{
					"slug": "muted",
					"color": "#4e4b66",
					"name": "Muted — secondary text"
				},
				{
					"slug": "accent",
					"color": "#2b2bd9",
					"name": "Accent — Qwerty blue"
				},
				{
					"slug": "accent-ink",
					"color": "#2b2bd9",
					"name": "Accent — readable as text"
				},
				{
					"slug": "accent-2",
					"color": "#1550b8",
					"name": "Accent — deep blue"
				},
				{
					"slug": "accent-3",
					"color": "#9d1d8f",
					"name": "Accent — magenta"
				},
				{
					"slug": "success",
					"color": "#0f7043",
					"name": "Success"
				},
				{
					"slug": "warning",
					"color": "#b02a1a",
					"name": "Warning"
				}
			],
			"gradients": [
				{
					"slug": "aurora",
					"name": "Aurora — cyan to fuchsia",
					"gradient": "linear-gradient(120deg, #4158d0 0%, #c850c0 52%, #ffcc70 100%)"
				},
				{
					"slug": "aurora-soft",
					"name": "Aurora soft — on dark",
					"gradient": "linear-gradient(160deg, #f7f8fd 0%, #eceefb 60%, #e2e4f8 100%)"
				},
				{
					"slug": "signal-fade",
					"name": "Signal fade — accent to transparent",
					"gradient": "linear-gradient(180deg, rgba(43,43,217,0.10) 0%, rgba(255,255,255,0) 100%)"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"customFontSize": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"dropCap": false,
			"writingMode": false,
			"fluid": {
				"minFontSize": "0.875rem",
				"minViewportWidth": "20rem",
				"maxViewportWidth": "90rem"
			},
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Manrope",
					"fontFamily": "Manrope, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD",
							"src": [
								"file:./assets/fonts/manrope-latin.woff2"
							]
						},
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF",
							"src": [
								"file:./assets/fonts/manrope-latin-ext.woff2"
							]
						},
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"unicodeRange": "U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116",
							"src": [
								"file:./assets/fonts/manrope-cyrillic.woff2"
							]
						}
					]
				},
				{
					"slug": "mono",
					"name": "Monospace",
					"fontFamily": "ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, 'Liberation Mono', monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"name": "X Small",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem",
					"fluid": {
						"min": "0.875rem",
						"max": "0.9375rem"
					}
				},
				{
					"slug": "medium",
					"name": "Medium",
					"size": "1.0625rem",
					"fluid": {
						"min": "1rem",
						"max": "1.0625rem"
					}
				},
				{
					"slug": "large",
					"name": "Large",
					"size": "1.25rem",
					"fluid": {
						"min": "1.125rem",
						"max": "1.25rem"
					}
				},
				{
					"slug": "x-large",
					"name": "X Large",
					"size": "1.75rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "2X Large",
					"size": "2.5rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.5rem"
					}
				},
				{
					"slug": "xxx-large",
					"name": "3X Large",
					"size": "3.5rem",
					"fluid": {
						"min": "2.25rem",
						"max": "3.5rem"
					}
				},
				{
					"slug": "display",
					"name": "Display",
					"size": "5rem",
					"fluid": {
						"min": "2.75rem",
						"max": "5rem"
					}
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"em",
				"rem",
				"%",
				"vw",
				"vh"
			],
			"customSpacingSize": true,
			"blockGap": true,
			"padding": true,
			"margin": true,
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "1 — 2XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "2 — XS",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "3 — S",
					"size": "1rem"
				},
				{
					"slug": "50",
					"name": "4 — M",
					"size": "1.5rem"
				},
				{
					"slug": "60",
					"name": "5 — L",
					"size": "2.5rem"
				},
				{
					"slug": "70",
					"name": "6 — XL",
					"size": "clamp(2.5rem, 5vw, 4rem)"
				},
				{
					"slug": "80",
					"name": "7 — 2XL (section)",
					"size": "clamp(3.5rem, 8vw, 6rem)"
				},
				{
					"slug": "90",
					"name": "8 — 3XL (hero)",
					"size": "clamp(5rem, 11vw, 9rem)"
				}
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "soft",
					"name": "Soft",
					"shadow": "0 1px 2px rgba(3, 3, 12, 0.4)"
				},
				{
					"slug": "card",
					"name": "Card",
					"shadow": "0 12px 32px -12px rgba(3, 3, 12, 0.65)"
				},
				{
					"slug": "glow",
					"name": "Signal glow",
					"shadow": "0 0 0 1px rgba(34, 211, 238, 0.35), 0 18px 48px -18px rgba(34, 211, 238, 0.45)"
				}
			]
		},
		"custom": {
			"focusRing": {
				"width": "3px",
				"offset": "2px",
				"color": "var(--wp--preset--color--accent)"
			},
			"radius": {
				"sm": "6px",
				"md": "12px",
				"lg": "20px",
				"pill": "999px"
			},
			"transition": {
				"fast": "140ms cubic-bezier(0.2, 0, 0, 1)",
				"base": "240ms cubic-bezier(0.2, 0, 0, 1)"
			},
			"tapTarget": "44px",
			"hairline": "2px",
			"icon": {
				"sm": "0.6rem",
				"md": "1rem"
			},
			"breakpoint": {
				"small": "480px"
			},
			"slider": {
				"slideWidthNarrow": "18rem",
				"slideWidth": "22rem",
				"slideWidthWide": "28rem",
				"slideWidthMobile": "82vw"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.65",
			"letterSpacing": "-0.005em"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--50)",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700",
					"lineHeight": "1.12",
					"letterSpacing": "-0.02em"
				},
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--medium)",
					"lineHeight": "1.4"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em",
					"lineHeight": "1.4"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-ink)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--contrast)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "700",
					"lineHeight": "1.2",
					"textDecoration": "none",
					"letterSpacing": "0.01em"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--30)",
						"bottom": "var(--wp--preset--spacing--30)",
						"left": "var(--wp--preset--spacing--50)",
						"right": "var(--wp--preset--spacing--50)"
					}
				},
				"border": {
					"radius": "var(--wp--custom--radius--pill)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--contrast)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "800",
					"letterSpacing": "-0.03em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--contrast)"
						},
						"typography": {
							"textDecoration": "none"
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xxx-large)"
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--muted)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--contrast)"
							}
						}
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--border)"
				}
			},
			"core/image": {
				"border": {
					"radius": "var(--wp--custom--radius--md)"
				}
			},
			"core/quote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.5"
				},
				"border": {
					"left": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/pullquote": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.3"
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"background": "var(--wp--preset--color--surface)",
					"text": "var(--wp--preset--color--contrast)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)",
					"color": "var(--wp--preset--color--border)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)",
						"left": "var(--wp--preset--spacing--50)",
						"right": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/preformatted": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/details": {
				"color": {
					"background": "var(--wp--preset--color--surface)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--md)",
					"color": "var(--wp--preset--color--border)",
					"style": "solid",
					"width": "1px"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)",
						"left": "var(--wp--preset--spacing--50)",
						"right": "var(--wp--preset--spacing--50)"
					}
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"color": "var(--wp--preset--color--border)"
				}
			}
		},
